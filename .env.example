# Modelo local con Ollama (por defecto, no hace falta .env)
BECAS_BASE_URL=http://localhost:11434/v1
BECAS_API_KEY=ollama
BECAS_MODEL=becas-qwen2.5
BECAS_TEMPERATURE=0.2

